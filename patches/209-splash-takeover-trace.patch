@@ -2792,7 +2792,9 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 	struct sde_connector *sde_conn = NULL;
 	struct sde_splash_display *splash_display;
 
+	a52_ackfr_record("SPLCFG209 enter kms=%d", !!kms);
 	if (!kms) {
+		a52_ackfr_record("SPLCFG209 fail stage=kms rc=%d", -EINVAL);
 		SDE_ERROR("invalid kms\n");
 		return -EINVAL;
 	}
@@ -2800,12 +2802,18 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 	sde_kms = to_sde_kms(kms);
 	dev = sde_kms->dev;
 	if (!dev) {
+		a52_ackfr_record("SPLCFG209 fail stage=dev rc=%d", -EINVAL);
 		SDE_ERROR("invalid device\n");
 		return -EINVAL;
 	}
 
+	a52_ackfr_record("SPLCFG209 counts regions=%u displays=%u dsi=%d",
+			sde_kms->splash_data.num_splash_regions,
+			sde_kms->splash_data.num_splash_displays,
+			sde_kms->dsi_display_count);
 	if (!sde_kms->splash_data.num_splash_regions ||
 			!sde_kms->splash_data.num_splash_displays) {
+		a52_ackfr_record("SPLCFG209 bypass no-splash rc=%d", rc);
 		DRM_INFO("cont_splash feature not enabled\n");
 		return rc;
 	}
@@ -2819,8 +2827,12 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 		display = sde_kms->dsi_displays[i];
 		dsi_display = (struct dsi_display *)display;
 		splash_display = &sde_kms->splash_data.splash_display[i];
+		a52_ackfr_record("SPLCFG209 display i=%d enabled=%d bridge=%d",
+			i, splash_display->cont_splash_enabled,
+			!!dsi_display->bridge);
 
 		if (!splash_display->cont_splash_enabled) {
+			a52_ackfr_record("SPLCFG209 skip i=%d", i);
 			SDE_DEBUG("display->name = %s splash not enabled\n",
 					dsi_display->name);
 			continue;
@@ -2833,7 +2845,10 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 			SDE_DEBUG("encoder name = %s\n", encoder->name);
 		}
 		memset(&info, 0x0, sizeof(info));
+		a52_ackfr_record("SPLCFG209 info enter i=%d enc=%d", i, !!encoder);
 		rc = dsi_display_get_info(NULL, &info, display);
+		a52_ackfr_record("SPLCFG209 info exit i=%d rc=%d conn=%d type=%d",
+			i, rc, info.is_connected, info.display_type);
 		if (rc) {
 			SDE_ERROR("dsi get_info %d failed\n", i);
 			encoder = NULL;
@@ -2844,6 +2859,8 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 			info.display_type);
 
 		if (!encoder) {
+			a52_ackfr_record("SPLCFG209 fail stage=encoder i=%d rc=%d",
+				i, -EINVAL);
 			SDE_ERROR("encoder not initialized\n");
 			return -EINVAL;
 		}
@@ -2852,10 +2869,14 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 		encoder->crtc = priv->crtcs[i];
 		crtc = encoder->crtc;
 		splash_display->encoder =  encoder;
+		a52_ackfr_record("SPLCFG209 objects i=%d crtc=%u enc=%u",
+			i, crtc->base.id, encoder->base.id);
 
 		SDE_DEBUG("for dsi-display:%d crtc id = %d enc id =%d\n",
 				i, crtc->base.id, encoder->base.id);
 
+		a52_ackfr_record("SPLCFG209 conn-find enter i=%d enc=%u",
+			i, encoder->base.id);
 		mutex_lock(&dev->mode_config.mutex);
 		drm_connector_list_iter_begin(dev, &conn_iter);
 		drm_for_each_connector_iter(connector, &conn_iter) {
@@ -2870,18 +2891,28 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 				break;
 		}
