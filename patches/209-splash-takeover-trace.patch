+		a52_ackfr_record("SPLCFG209 mode i=%d id=%u type=0x%x flags=0x%x",
+			i, drm_mode->base.id, drm_mode->type, drm_mode->flags);
 		SDE_DEBUG("drm_mode->name = %s, id=%d, type=0x%x, flags=0x%x\n",
 				drm_mode->name, drm_mode->base.id,
 				drm_mode->type, drm_mode->flags);
 
 		/* Update CRTC drm structure */
 		crtc->state->active = true;
+		a52_ackfr_record("SPLCFG209 set-mode enter i=%d crtc=%u",
+			i, crtc->base.id);
 		rc = drm_atomic_set_mode_for_crtc(crtc->state, drm_mode);
+		a52_ackfr_record("SPLCFG209 set-mode exit i=%d rc=%d", i, rc);
 		if (rc) {
 			SDE_ERROR("Failed: set mode for crtc. rc = %d\n", rc);
 			return rc;
@@ -2908,23 +2945,34 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 		drm_mode_copy(&crtc->mode, drm_mode);
 
 		/* Update encoder structure */
+		a52_ackfr_record("SPLCFG209 enc-caps enter i=%d", i);
 		sde_encoder_update_caps_for_cont_splash(encoder,
 				splash_display, true);
+		a52_ackfr_record("SPLCFG209 enc-caps exit i=%d", i);
 
+		a52_ackfr_record("SPLCFG209 crtc-set enter i=%d", i);
 		sde_crtc_update_cont_splash_settings(crtc);
+		a52_ackfr_record("SPLCFG209 crtc-set exit i=%d", i);
 
 		sde_conn = to_sde_connector(connector);
+		a52_ackfr_record("SPLCFG209 conn-cb enter i=%d has=%d", i,
+				sde_conn && sde_conn->ops.cont_splash_config);
 		if (sde_conn && sde_conn->ops.cont_splash_config)
 			sde_conn->ops.cont_splash_config(sde_conn->display);
+		a52_ackfr_record("SPLCFG209 conn-cb exit i=%d", i);
 
+		a52_ackfr_record("SPLCFG209 planes enter i=%d", i);
 		rc = _sde_kms_update_planes_for_cont_splash(sde_kms,
 				splash_display, crtc);
+		a52_ackfr_record("SPLCFG209 planes exit i=%d rc=%d", i, rc);
 		if (rc) {
 			SDE_ERROR("Failed: updating plane status rc=%d\n", rc);
 			return rc;
 		}
+		a52_ackfr_record("SPLCFG209 display exit i=%d rc=%d", i, rc);
 	}
 
+	a52_ackfr_record("SPLCFG209 exit rc=%d", rc);
 	return rc;
 }
 