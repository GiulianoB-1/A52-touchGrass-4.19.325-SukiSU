+/* A52_DSI_CMD_TRACE_PLAIN_V1: plain text, no correction or binary format. */
+static void a52_dsi_log_msg(struct dsi_ctrl *ctrl,
+			    const struct mipi_dsi_msg *msg, u32 flags)
+{
+	const u8 *b;
+	u8 h[8] = { 0 };
+	u8 z[4] = { 0 };
+	size_t n;
+
+	if (!msg)
+		return;
+	b = msg->tx_buf;
+	n = min_t(size_t, msg->tx_len, ARRAY_SIZE(h));
+	if (b && n)
+		memcpy(h, b, n);
+	if (b && msg->tx_len) {
+		n = min_t(size_t, msg->tx_len, ARRAY_SIZE(z));
+		memcpy(z, b + msg->tx_len - n, n);
+	}
+	a52_ackfr_record(
+		"DISP DSI i=%d t=%02x c=%u f=%x n=%zu r=%zu h=%02x%02x%02x%02x%02x%02x%02x%02x z=%02x%02x%02x%02x",
+		ctrl ? ctrl->cell_index : -1, msg->type, msg->channel, flags,
+		msg->tx_len, msg->rx_len, h[0], h[1], h[2], h[3],
+		h[4], h[5], h[6], h[7], z[0], z[1], z[2], z[3]);
+}
+
 int dsi_ctrl_cmd_transfer(struct dsi_ctrl *dsi_ctrl,
 			  const struct mipi_dsi_msg *msg,
 			  u32 *flags)
@@ -3316,6 +3349,7 @@ int dsi_ctrl_cmd_transfer(struct dsi_ctrl *dsi_ctrl,
 		return -EINVAL;
 	}
 
+	a52_dsi_log_msg(dsi_ctrl, msg, flags ? *flags : 0);
 	mutex_lock(&dsi_ctrl->ctrl_lock);
 
 	rc = dsi_ctrl_check_state(dsi_ctrl, DSI_CTRL_OP_CMD_TX, 0x0);
@@ -3341,6 +3375,9 @@ int dsi_ctrl_cmd_transfer(struct dsi_ctrl *dsi_ctrl,
 
 error:
 	mutex_unlock(&dsi_ctrl->ctrl_lock);
+	if (rc < 0)
+		a52_ackfr_record("DISP DSI fail i=%d t=%02x rc=%d",
+			dsi_ctrl->cell_index, msg->type, rc);
 	return rc;
 }
 
