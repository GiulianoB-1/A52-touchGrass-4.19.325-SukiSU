 			SDE_ERROR("connector not initialized\n");
 			mutex_unlock(&dev->mode_config.mutex);
 			return -EINVAL;
 		}
 
 		if (connector->funcs->fill_modes) {
+			a52_ackfr_record("SPLCFG209 fill enter i=%d conn=%u",
+				i, connector->base.id);
 			connector->funcs->fill_modes(connector,
 					dev->mode_config.max_width,
 					dev->mode_config.max_height);
+			a52_ackfr_record("SPLCFG209 fill exit i=%d empty=%d",
+				i, list_empty(&connector->modes));
 		} else {
+			a52_ackfr_record("SPLCFG209 fail stage=fill-api i=%d rc=%d",
+				i, -EINVAL);
 			SDE_ERROR("fill_modes api not defined\n");
 			mutex_unlock(&dev->mode_config.mutex);
 			return -EINVAL;
@@ -2891,15 +2922,21 @@ static int sde_kms_cont_splash_config(struct msm_kms *kms)
 		crtc->state->encoder_mask = (1 << drm_encoder_index(encoder));
 
 		/* currently consider modes[0] as the preferred mode */
+		a52_ackfr_record("SPLCFG209 mode-pick enter i=%d", i);
 		drm_mode = list_first_entry(&connector->modes,
