# Phase319 source-only historical Workflow68 compatibility config.
#
# The Phase175 source regeneration replays historical Run29/Run30/Run31
# wrappers from scripts/94b_stage_a52xq_ufs_phy_bridge.py. Those wrappers
# require this path only so they can quarantine configuration symbols that
# affected their old hardware test images. The Phase319 regeneration is
# source-only: this file is not used as the final Phase316 build config.
#
# Keep exactly one entry for every symbol touched by those historical wrappers.
# The wrappers deterministically replace these entries with "is not set" while
# replaying the historical sequence. Exact source identity is still enforced by
# the immutable Phase175 patch SHA256 and the final Phase316 source/config oracle.
CONFIG_CAM_CC_LAGOON=y
CONFIG_DISP_CC_LAGOON=y
CONFIG_GPU_CC_LAGOON=y
CONFIG_VIDEO_CC_LAGOON=y
CONFIG_KASAN=y
CONFIG_NPU_CC_LAGOON=y
CONFIG_QCOM_CLK_DEBUG=y
CONFIG_DEBUG_CC_LAGOON=y
