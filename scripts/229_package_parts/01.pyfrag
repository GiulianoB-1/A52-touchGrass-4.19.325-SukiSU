            raise RuntimeError(f"missing comparison output: {name}")

    audit_dir = root / "audit/phase229"
    audit_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy2("scripts/227_phase226_retention_wrapper.py", audit_dir / "phase229_kgsl_bindpath_loader.py")
    shutil.copy2("scripts/228_phase227_tritrack_wrapper.py", audit_dir / "phase228_tri_track_wrapper.py")
    shutil.copy2("scripts/229_package.py", audit_dir / "phase229_package_loader.py")
    shutil.copytree("scripts/229_patcher_parts", audit_dir / "patcher_parts", dirs_exist_ok=True)
    shutil.copytree("scripts/229_package_parts", audit_dir / "package_parts", dirs_exist_ok=True)
    shutil.copy2("scripts/229_design.md", root / "PHASE229-DESIGN.md")
    shutil.copy2("scripts/229_trigger.txt", root / "PHASE229-HARDWARE-TEST.txt")

    audit_path = root / "final-audit.json"
    audit = json.loads(audit_path.read_text())
    audit.update({
        "phase": 229,
        "base_phase": 228,
        "functional_base_phase": 228,
        "hardware_validated": False,
        "status": "phase229-kgsl-touchgrass-binding-path-ci-audited-not-hardware-validated",
        "trace_marker_prefix": "KGPPOST 229",
        "phase228_tri_track_retained": True,
        "phase226_odspost_retained": True,
        "phase229_touchgrass_commit": "6bf351bdf18bdb228db79e66f14a7a9c0178e5d7",
        "phase229_snapshot_interval_seconds": 2,
        "phase229_snapshot_limit": 110,
        "phase229_behavior_changed": False,
        "phase229_security_decisions_changed": False,
        "phase229_rs_roots": 48,
    })
    retained = list(audit.get("post_capacity_retention", []))
    for marker in ("ODSPOST", "TRIPOST", "KGPPOST"):
        if marker not in retained:
            retained.append(marker)
    audit["post_capacity_retention"] = retained
    audit_path.write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n")

    identity = {
        "phase": 229,
        "git_sha": os.environ.get("GITHUB_SHA"),
        "git_ref": os.environ.get("GITHUB_REF"),
        "run_id": os.environ.get("GITHUB_RUN_ID"),
        "run_number": os.environ.get("GITHUB_RUN_NUMBER"),
        "source_builder_run_id": str(source_run_id),
        "source_builder_run_url": source_run_url,
        "touchgrass_commit": "6bf351bdf18bdb228db79e66f14a7a9c0178e5d7",
        "hardware_validated": False,
        "change": "KGSL TouchGrass source comparison and live Adreno platform-binding trace",
        "rs_roots": 48,
    }
    (root / "BUILD-IDENTITY.json").write_text(json.dumps(identity, indent=2, sort_keys=True) + "\n")
    (root / "README-FIRST.txt").write_text(
        "A52 GKI 5.10 Phase 229 KGSL TouchGrass binding-path candidate\n\n"
        "FLASH ONLY AFTER SHA256SUMS AND THE PACKAGE AUDIT PASS:\n"
        "  package/boot.img -> BOOT partition\n\n"
        "Phase 229 preserves Phase 228 vold, odsign/odrefresh, SurfaceFlinger\n"
        "and KGSL recording. It adds a bounded read-only trace of the live\n"
        "qcom,kgsl-3d0 DT node, platform-device population, driver binding and\n"
        "Adreno probe result, plus an exact comparison with pinned TouchGrass.\n\n"
        "Reed-Solomon remains RS48. No DT, probe result, service, security,\n"
        "display, GPU power or firmware behavior is changed.\n\n"
        "CI-validated, not hardware-validated. Follow PHASE229-HARDWARE-TEST.txt.\n"
    )

    sums = root / "SHA256SUMS"
    if sums.exists():
        sums.unlink()
    files = sorted(p for p in root.rglob("*") if p.is_file() and p.name != "SHA256SUMS")
    sums.write_text("".join(f"{sha256(p)}  ./{p.relative_to(root)}\n" for p in files))
    for p in files:
        if sha256(p) not in sums.read_text():
            raise RuntimeError(f"checksum list missing {p}")

    out = Path("phase229-out")
